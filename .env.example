# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Lista de modelos, en orden de intento (fallback). El primero que responda gana.
# Deja solo modelos ":free" mientras desarrollas; agrega uno pagado barato al final
# antes de producción (ver conversación sobre cuotas de OpenRouter).
# NOTA: el catálogo ":free" de OpenRouter rota con el tiempo (modelos viejos se
# deprecan a favor de la versión de pago). Lista verificada el 2026-09-28 contra
# https://openrouter.ai/api/v1/models filtrando ":free" + soporte de tool-calling.
# Si en el futuro vuelves a ver errores 404 "unavailable for free", vuelve a
# consultar ese endpoint para refrescar esta lista. Además del soporte nominal
# de "tools" en la API, verifica con un agendamiento real que el modelo SÍ
# invoque las tools de verdad — un modelo muy pequeño (ej. menos de ~10B
# parámetros) puede aceptar el parámetro y aun así "alucinar" el texto de la
# tool en vez de llamarla (nos pasó con liquid/lfm-2.5-2.6b:free).
# 6 modelos de proveedores DISTINTOS a propósito (Qwen/Alibaba, Google,
# Nvidia x2, Cohere, Thinking Machines): si dos o tres coinciden saturados al
# mismo tiempo (pasa en el pool compartido de OpenRouter), sigue habiendo
# alternativas de otro proveedor antes de agotar todo el fallback.
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,thinkingmachines/inkling:free

# --- Supabase ---
# URL del proyecto (para la API REST/PostgREST, no la cadena de conexión a Postgres).
SUPABASE_URL=https://zvxvtnxifmgubrgqegoh.supabase.co
# service_role key (JWT largo, empieza con "eyJ..."): Project Settings -> API ->
# Project API keys -> service_role. NO es la contraseña de la base de datos.
SUPABASE_SERVICE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY
SUPABASE_TABLE_CITAS=servicios_agendados
# AJUSTA este nombre al de tu tabla real de catálogo de servicios técnicos —
# no venía en los archivos que compartiste, este es un valor de partida.
SUPABASE_TABLE_CATALOGO=servicios_tecnicos
# Memoria conversacional de los agentes (esquema en supabase/migrations/20260927000001_conversaciones.sql).
SUPABASE_TABLE_CONVERSACIONES=conversaciones
# Técnicos y agendamiento por técnico (esquema en supabase/migrations/20260928000003_tecnicos.sql).
SUPABASE_TABLE_TECNICOS=tecnicos

# --- Zona horaria ---
TIMEZONE_OFFSET=-05:00

# --- Seguridad del API (docs/PLAN_DE_MEJORAS.md, Fase 1) ---
# Clave que exigen todas las rutas /api/* en la cabecera X-API-Key. Si se deja
# vacía, el API queda ABIERTO (solo aceptable en desarrollo local).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Mensajes permitidos por sesión (teléfono) en /api/chat.
LIMITE_MENSAJES_POR_MINUTO=10
LIMITE_MENSAJES_POR_DIA=200

# --- Resiliencia y presupuesto de turno (docs/PLAN_DE_MEJORAS.md, Fases 2 y 3) ---
# Timeouts en segundos. Opcionales: estos son los valores por defecto.
LLM_TIMEOUT_CONEXION=5
LLM_TIMEOUT_LECTURA=45
SUPABASE_TIMEOUT_CONEXION=5
SUPABASE_TIMEOUT_LECTURA=15
# Tope COMPARTIDO por orquestador y sub-agente en un mismo mensaje del cliente.
# Cuenta cada intento a un modelo (también los que fallan y pasan al siguiente).
MAX_LLAMADAS_LLM_POR_TURNO=15
SEGUNDOS_MAX_POR_TURNO=90

# --- Contexto de conversación (docs/PLAN_DE_MEJORAS.md, Fase 6). Opcionales. ---
# Turnos del cliente que se envían al modelo en cada llamada.
CONTEXTO_MAX_TURNOS=12
# Al guardar: los resultados de tools de más de N caracteres, anteriores a los
# últimos TURNOS_INTACTOS turnos, se recortan (salvo el último de cada tool).
CONTEXTO_TURNOS_INTACTOS=4
CONTEXTO_MAX_CARACTERES_TOOL=1500
# Tope de mensajes guardados por agente y sesión en la tabla conversaciones.
CONTEXTO_MAX_MENSAJES_GUARDADOS=300

# --- Observabilidad (docs/PLAN_DE_MEJORAS.md, Fase 8) ---
# 1 = cada evento del agente se escribe como una línea JSON en stdout, con
# teléfonos y nombres enmascarados (para reconstruir turnos desde los logs del
# hosting). 0 = desactivado.
LOG_EVENTOS_JSON=1

# --- MercadoPago (docs/PLAN_DE_MEJORAS.md, Fase 12, paso C) ---
# Access token: Tus integraciones -> tu aplicación -> Credenciales. Usa las de
# PRUEBA (empiezan con TEST-) mientras desarrollas. Vacío = sin pago en línea.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta para verificar la firma de los avisos (Tus integraciones ->
# Webhooks). Vacía = no se verifica (los estados igual se leen de la API).
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública HTTPS de este servidor (Render, o un túnel en local). MercadoPago
# avisa a <URL_PUBLICA_BASE>/webhooks/mercadopago. Vacía = no hay avisos; el
# estado se concilia cuando el cliente pregunta por su pedido.
URL_PUBLICA_BASE=
# Horas para pagar un pedido en línea antes de que se cancele y libere stock.
ORDEN_EN_LINEA_EXPIRA_HORAS=24
# Contacto para cancelar/reembolsar un pedido ya pagado (ej. un WhatsApp o correo).
CONTACTO_EMPRESA=
